FOV.circle=Drawing.new("Circle"); FOV.circle.Thickness=3; FOV.circle.NumSides=128; FOV.circle.Visible=false; FOV.circle.Color=Color3.fromRGB(255,255,255); FOV.circle.Transparency=0.3
FOV.fill=Drawing.new("Circle"); FOV.fill.NumSides=128; FOV.fill.Visible=false; FOV.fill.Thickness=FOV.radius; FOV.fill.Transparency=0.8; FOV.fill.Radius=FOV.radius
FOV.arms={}; for i=1,8 do FOV.arms[i]=Drawing.new("Line"); FOV.arms[i].Thickness=5; FOV.arms[i].Visible=false; FOV.arms[i].Color=Color3.fromRGB(255,255,255); FOV.arms[i].Transparency=0.2 end
FOV.glow=Drawing.new("Circle"); FOV.glow.Thickness=1; FOV.glow.NumSides=128; FOV.glow.Visible=false; FOV.glow.Radius=FOV.radius+6; FOV.glow.Color=Color3.fromRGB(255,255,255); FOV.glow.Transparency=0.6

local FG=Tabs.Combat:AddLeftGroupbox("FOV Circle")
local fovTog=FG:AddToggle("FOVToggle",{Text="FOV 원 표시",Default=true,Tooltip="Wallbang 활성화시 FOV 원 표시"})
FG:AddSlider("FOVRadius",{Text="반지름",Default=300,Min=80,Max=500,Rounding=0,Suffix="px",Callback=function(v) FOV.radius=v; FOV.circle.Radius=v; FOV.fill.Radius=v; FOV.fill.Thickness=v; FOV.glow.Radius=v+6 end})
FG:AddSlider("FOVTransparency",{Text="채움 투명도",Default=80,Min=0,Max=100,Rounding=0,Suffix="%",Callback=function(v) FOV.fill.Transparency=v/100 end})
FG:AddSlider("FOVSpeed",{Text="회전 속도",Default=1.5,Min=0.1,Max=5,Rounding=1,Callback=function(v) FOV.rotationSpeed=v end})
FG:AddDropdown("FOVMode",{Text="위치",Values={"화면 중앙","마우스 위치"},Default=1})
local mouseFOV=false
Options.FOVMode:OnChanged(function(v) mouseFOV=(v=="마우스 위치") end)

RunService:BindToRenderStep("LynoriaFOV",200,function()
    if library_unloaded then RunService:UnbindFromRenderStep("LynoriaFOV"); for _,v in pairs(FOV) do if type(v)=="Drawing" then pcall(function() v:Remove() end) elseif type(v)=="table" then for _,l in ipairs(v) do pcall(function() l:Remove() end) end end end; return end
    local wb=RivalsWallbang and RivalsWallbang.enabled; local ft=fovTog and fovTog.Value
    if not wb or not ft then FOV.circle.Visible=false; FOV.fill.Visible=false; FOV.glow.Visible=false; for _,a in ipairs(FOV.arms) do a.Visible=false end; FOV.active=false; return end
    FOV.active=true
    local center = mouseFOV and UserInputService:GetMouseLocation() or Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    FOV.hue = (FOV.hue + 0.005) % 1
    local rc1 = Color3.fromHSV(FOV.hue, 1, 1); local rc2 = Color3.fromHSV((FOV.hue+0.3)%1, 1, 0.8); local rc3 = Color3.fromHSV((FOV.hue+0.6)%1, 1, 0.9)
    FOV.circle.Position=center; FOV.circle.Visible=true
    FOV.fill.Position=center; FOV.fill.Color=rc1; FOV.fill.Visible=true
    FOV.glow.Position=center; FOV.glow.Color=rc2; FOV.glow.Visible=true
    local angle=(tick()*FOV.rotationSpeed)%(math.pi*2)
    for i=1,8 do
        local a=angle+(i-1)*(math.pi/4); local dx=math.cos(a)*FOV.armLength; local dy=math.sin(a)*FOV.armLength; local gx=math.cos(a)*FOV.innerGap; local gy=math.sin(a)*FOV.innerGap
        FOV.arms[i].From=center+Vector2.new(gx,gy); FOV.arms[i].To=center+Vector2.new(dx,dy); FOV.arms[i].Color=(i%2==0) and rc2 or rc3; FOV.arms[i].Visible=true
    end
end)

print("[Lynoria Nexus.hub] ALL SYSTEMS OPERATIONAL. All issues fixed.")
